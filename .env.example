# Windows companion
NERV_PAIRING_TOKEN=replace-with-a-random-secret-at-least-24-characters
NERV_RELAY_URL=https://your-cloudflare-worker.example
NERV_RELAY_DEVICE_ID=replace-with-the-configured-device-id
NERV_RELAY_DEVICE_TOKEN=replace-with-a-different-random-device-secret

# Configure these as Cloudflare Worker secrets, not as checked-in values.
# These Worker values are not secret except for the listed secret tokens,
# but must be set to match the corresponding local/Netlify settings.
# DEVICE_ID matches NERV_RELAY_DEVICE_ID.
# PAIRING_CODE must match NERV_PAIRING_TOKEN.
# DEVICE_TOKEN must match NERV_RELAY_DEVICE_TOKEN.
# INTERNAL_API_SECRET must match NERV_RELAY_PROXY_SECRET in both Netlify sites.

# Configure in each Netlify site's Functions environment (not build-only scope).
NERV_RELAY_PROXY_SECRET=replace-with-a-third-random-secret
NERV_RELAY_DEVICE_ID=replace-with-the-configured-device-id
NERV_RELAY_URL=https://your-cloudflare-worker.example

# LOQ Link frontend build; this is a public URL, not a credential.
NERV_DECK_URL=https://your-nerv-deck.netlify.app
